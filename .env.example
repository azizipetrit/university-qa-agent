# --- Required ---------------------------------------------------------------

# Which model to use, as "provider:model". Any provider langchain supports works
# once its package is installed (langchain-anthropic is installed by default).
LLM_MODEL=anthropic:claude-opus-5-5

# The key for that provider.
ANTHROPIC_API_KEY=

# The database to answer questions about (a SQLAlchemy URL).
# Build the demo database first: uv run python -m university.build_db
DATABASE_URL=sqlite:///university/university.db

# --- Optional ---------------------------------------------------------------

# Plain-text notes about what the data means, appended to the schema.
SCHEMA_NOTES_FILE=university/notes.md

# How the model is asked for structured output. Leave empty for the provider's
# default. "json_schema" is the reliable choice for current Anthropic models.
STRUCTURED_OUTPUT_METHOD=json_schema

# Sample rows per table included in the schema text. These rows are sent to the
# model provider. Set to 0 to send none.
SAMPLE_ROWS=3

# Limits.
MAX_ROWS=50          # rows returned per query
MAX_ATTEMPTS=3       # tries to get one valid query
MAX_QUERIES=3        # queries run per question
MAX_LLM_CALLS=10     # model calls per question, whatever happens

# Where trace files are written (one JSON file per question).
TRACE_DIR=traces

# --- LangSmith (optional, in addition to the local traces) -------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=university-qa-agent
